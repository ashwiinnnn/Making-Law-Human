<section id="ai" style="background:var(--ink);color:var(--paper);">
  <div class="wrap-wide reveal">
    <span class="eyebrow" style="color:var(--yellow);">The Central Question</span>
    <h2 style="color:var(--paper);max-width:22ch;">Can AI generate a legally correct document that a human cannot understand?</h2>
    <div class="origin-illus" style="margin:36px 0 44px;">
      <svg viewBox="0 0 640 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="AI drafts a valid document, but the human reading it is left confused">
        <rect x="0" y="35" width="150" height="80" rx="4" fill="none" stroke="#b3ab97" stroke-width="1.6"/>
        <rect x="20" y="52" width="60" height="10" rx="2" fill="#b3ab97" opacity=".5"/>
        <path d="M20 72h110M20 84h90M20 96h70" stroke="#b3ab97" stroke-width="1.4"/>
        <text x="0" y="24" font-family="Space Mono, monospace" font-size="9.5" fill="#8a8371" letter-spacing="1">AI-DRAFTED CONTRACT</text>
        <path d="M160 75h55" stroke="var(--yellow)" stroke-width="2" marker-end="url(#arrow1)"/>
