<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Human Law Project — Case File</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
  --paper:#efe8d4;
  --paper-2:#e7dfc7;
  --ink:#1c1a15;
  --ink-dim:#6b6455;
  --line:#c9bfa0;
  --yellow:#f5d444;
  --red:#b3261e;
  --blue:#1d4ed8;
  --mono:'Space Mono',monospace;
  --sans:'Inter',sans-serif;
  --legal:Georgia,'Times New Roman',serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
p{text-align:justify;text-justify:inter-word;}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--sans);
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  background-image:
    radial-gradient(circle at 1px 1px, rgba(0,0,0,.035) 1px, transparent 0);
  background-size:4px 4px;
}
::selection{background:var(--yellow);color:var(--ink);}
a{color:inherit;}
button{font-family:inherit;cursor:pointer;}
.wrap{max-width:760px;margin:0 auto;padding:0 24px;}
.wrap-wide{max-width:1080px;margin:0 auto;padding:0 24px;}

/* progress */
#progress{position:fixed;top:0;left:0;height:3px;background:var(--red);width:0%;z-index:300;transition:width .1s linear;}

/* ===== FOLDER TAB NAV ===== */
.tabnav{position:sticky;top:0;z-index:100;background:var(--paper);border-bottom:2px solid var(--ink);}
.tabnav-inner{max-width:1080px;margin:0 auto;display:flex;overflow-x:auto;padding:0 24px;}
.tabnav a{
  font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;
  white-space:nowrap;padding:14px 16px;border-right:1px solid var(--line);color:var(--ink-dim);
  text-decoration:none;flex-shrink:0;transition:.15s;
}
.tabnav a:hover{background:var(--yellow);color:var(--ink);}

/* ===== STAMP ===== */
.stamp{
  display:inline-block;border:3px solid var(--red);color:var(--red);
  font-family:var(--mono);font-weight:700;font-size:12px;letter-spacing:.14em;
  text-transform:uppercase;padding:7px 16px;transform:rotate(-3deg);
  border-radius:3px;
}

/* ===== HERO ===== */
.hero{min-height:92vh;display:flex;flex-direction:column;justify-content:center;padding:100px 24px 60px;position:relative;}
.hero-inner{max-width:900px;margin:0 auto;width:100%;}
.hero .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-dim);margin-bottom:26px;}
.hero h1{
  font-size:clamp(32px,6vw,68px);font-weight:900;letter-spacing:-0.015em;line-height:1.18;
  margin-bottom:18px;text-align:left;
}
.hero h1 .strike{position:relative;color:var(--ink-dim);}
.hero h1 .strike::after{content:'';position:absolute;left:-1%;right:-1%;top:56%;height:4px;background:var(--red);transform:rotate(-1deg);}
.hero p.sub{font-size:clamp(16px,2vw,20px);color:var(--ink-dim);max-width:52ch;margin-top:20px;text-align:left;}
.hero-cta{margin-top:44px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.hero-cta .arrow{font-family:var(--mono);font-size:13px;color:var(--ink-dim);}

/* ===== REDESIGN TOGGLE (signature interaction) ===== */
.redesign-block{margin-top:60px;border:2px solid var(--ink);background:var(--paper-2);}
.redesign-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;border-bottom:2px solid var(--ink);background:var(--ink);color:var(--paper);flex-wrap:wrap;gap:12px;}
.redesign-bar .filetitle{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;}
.toggle{
  display:flex;align-items:center;gap:0;border:1px solid var(--paper);border-radius:20px;overflow:hidden;
}
.toggle button{
  border:none;background:transparent;color:var(--paper);font-family:var(--mono);font-size:11px;
  letter-spacing:.06em;text-transform:uppercase;padding:8px 16px;transition:.2s;
}
.toggle button.active{background:var(--yellow);color:var(--ink);font-weight:700;}
.redesign-content{padding:38px;transition:padding .4s ease;}

/* legal (default/before) mode */
.doc{transition:all .1s;}
.doc.legal p{
  font-family:var(--legal);font-size:12.5px;line-height:1.35;color:#3a362c;
  text-align:justify;margin-bottom:10px;letter-spacing:0.01em;
}
.doc.legal .doc-head{font-family:var(--legal);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:14px;color:#3a362c;}
.doc.legal .doc-clause-num{font-family:var(--legal);font-weight:700;}

/* human (after) mode */
.doc.human p{
  font-family:var(--sans);font-size:18px;line-height:1.65;color:var(--ink);
  text-align:left;margin-bottom:20px;max-width:60ch;
}
.doc.human .doc-head{font-family:var(--sans);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:18px;}
.doc.human mark{background:var(--yellow);padding:2px 5px;border-radius:2px;}
.doc.human p.pull{font-size:23px;font-weight:800;line-height:1.4;max-width:22ch;margin:28px 0;}

.redesign-caption{padding:0 38px 30px;font-family:var(--mono);font-size:12px;color:var(--ink-dim);}

/* ===== SECTION SHELL ===== */
section{padding:110px 0;border-top:2px solid var(--ink);}
section.tight{padding:80px 0;}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--red);margin-bottom:18px;display:block;}
h2{font-size:clamp(28px,4vw,44px);font-weight:900;letter-spacing:-0.015em;margin-bottom:26px;max-width:18ch;}
.lede{font-size:19px;color:var(--ink-dim);max-width:58ch;margin-bottom:40px;text-align:left;}
.exhibit-tag{font-family:var(--mono);font-size:11px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.1em;}

/* ===== ORIGIN PROSE ===== */
.prose p{font-size:17px;text-align:justify;margin-bottom:20px;max-width:65ch;}
.prose p.pull{font-size:22px;font-weight:800;text-align:left;line-height:1.4;max-width:24ch;margin:36px 0;}

/* ===== REASONABLE TIME ===== */
.rt-box{border:2px solid var(--ink);background:var(--paper-2);padding:40px;margin-top:36px;}
.rt-clause{font-family:var(--mono);font-size:17px;font-weight:700;margin-bottom:32px;line-height:1.6;}
.rt-clause .fill{color:var(--red);}
input[type="range"]{width:100%;-webkit-appearance:none;height:4px;background:var(--line);border-radius:2px;outline:none;margin-bottom:14px;}
input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;background:var(--red);border-radius:50%;cursor:pointer;box-shadow:0 0 0 4px var(--paper-2);}
input[type="range"]::-moz-range-thumb{width:20px;height:20px;background:var(--red);border-radius:50%;cursor:pointer;border:none;}
.rt-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-dim);font-family:var(--mono);margin-bottom:26px;text-transform:uppercase;}
.rt-meter{height:12px;background:#ddd3b3;border-radius:8px;overflow:hidden;margin-bottom:12px;border:1px solid var(--ink);}
.rt-meter-fill{height:100%;background:linear-gradient(90deg,var(--yellow),var(--red));width:20%;transition:width .15s ease;}
.rt-meter-label{font-size:13px;font-family:var(--mono);color:var(--ink-dim);}

/* ===== QUESTIONS ===== */
.questions{border-top:1px solid var(--line);}
.question{padding:26px 0;border-bottom:1px solid var(--line);font-size:clamp(18px,2.4vw,25px);font-weight:700;display:flex;gap:20px;align-items:baseline;transition:.2s;}
.question:hover{color:var(--red);}
.question span{font-size:12px;color:var(--ink-dim);font-weight:500;white-space:nowrap;font-family:var(--mono);}

/* ===== DISCIPLINES ===== */
.disc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;background:var(--ink);border:2px solid var(--ink);}
.disc-card{background:var(--paper);padding:32px;}
.disc-card h3{font-size:17px;font-weight:800;margin-bottom:14px;}
.disc-card ul{list-style:none;}
.disc-card li{font-size:14px;color:var(--ink-dim);padding:5px 0;border-top:1px dashed var(--line);}
.disc-card li:first-child{border-top:none;}
@media (max-width:640px){.disc-grid{grid-template-columns:1fr;}}

/* ===== FRAMEWORK ===== */
.layers{counter-reset:layer;border-top:1px solid var(--line);}
.layer{counter-increment:layer;display:grid;grid-template-columns:64px 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--line);align-items:start;}
.layer::before{content:counter(layer,decimal-leading-zero);font-size:14px;font-weight:700;color:var(--red);font-family:var(--mono);padding-top:2px;}
.layer h4{font-size:19px;font-weight:800;margin-bottom:6px;}
.layer p{font-size:15px;color:var(--ink-dim);max-width:52ch;}

/* ===== COLOR EXHIBITS ===== */
.color-exhibit{padding:100px 0;color:#fff;border-top:2px solid var(--ink);}
.color-exhibit.blue{background:var(--blue);}
.color-exhibit.red{background:var(--red);}
.color-exhibit.yellow{background:var(--yellow);color:var(--ink);}
.color-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:56px;flex-wrap:wrap;gap:16px;}
.color-head .tag{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.8;font-family:var(--mono);}
.color-head h2{color:inherit;max-width:none;margin-bottom:0;}
.color-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1px;margin:40px 0 56px;border-top:1px solid rgba(255,255,255,.3);border-bottom:1px solid rgba(255,255,255,.3);}
.yellow .color-stats{border-color:rgba(0,0,0,.2);}
.color-stat{padding:22px 0;}
.color-stat .num{font-size:34px;font-weight:800;display:block;font-family:var(--mono);}
.color-stat .cap{font-size:13px;opacity:.8;}
.color-body p{font-size:17px;max-width:62ch;margin-bottom:18px;text-align:justify;}
.color-body p.quote{font-size:22px;font-weight:800;font-style:italic;max-width:26ch;margin:32px 0;text-align:left;}
.use-cases{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:44px;}
.use-case{border:1px solid rgba(255,255,255,.4);padding:20px;}
.yellow .use-case{border-color:rgba(0,0,0,.28);}
.use-case .n{font-size:12px;opacity:.75;margin-bottom:8px;display:block;font-family:var(--mono);}
.use-case p{font-size:14px;margin:0;opacity:.92;text-align:left;}
.avoid-list{margin-top:40px;font-size:14px;opacity:.9;}
.avoid-list div{padding:10px 0;border-top:1px solid rgba(255,255,255,.3);}
.yellow .avoid-list div{border-color:rgba(0,0,0,.2);}

/* ===== CLAUSE X-RAY ===== */
.demo{background:var(--ink);color:var(--paper);}
.demo .eyebrow{color:var(--yellow);}
.demo-shell{border:2px solid #3a362c;background:#232019;margin-top:40px;}
.demo-toolbar{display:flex;gap:10px;padding:18px 24px;border-bottom:2px solid #3a362c;flex-wrap:wrap;align-items:center;}
.demo-toolbar span.hint{font-family:var(--mono);font-size:12px;color:#8a8371;margin-right:8px;}
.swatch-btn{border:1px solid #4a4636;background:transparent;color:var(--paper);font-size:13px;padding:9px 16px;border-radius:2px;transition:.15s;font-family:var(--mono);}
.swatch-btn[data-c="red"]:hover,.swatch-btn[data-c="red"].active{background:var(--red);border-color:var(--red);color:#fff;}
.swatch-btn[data-c="blue"]:hover,.swatch-btn[data-c="blue"].active{background:var(--blue);border-color:var(--blue);color:#fff;}
.swatch-btn[data-c="yellow"]:hover,.swatch-btn[data-c="yellow"].active{background:var(--yellow);border-color:var(--yellow);color:#111;}
.swatch-btn[data-c="none"].active{background:#4a4636;border-color:#6a6656;}
.demo-body{padding:36px;font-size:17px;line-height:1.7;}
.demo-body mark{background:transparent;color:inherit;padding:2px 4px;border-radius:2px;transition:.25s;}
.demo-body[data-active="red"] mark.tag-red{background:var(--red);color:#fff;}
.demo-body[data-active="blue"] mark.tag-blue{background:var(--blue);color:#fff;}
.demo-body[data-active="yellow"] mark.tag-yellow{background:var(--yellow);color:#111;}
.demo-caption{padding:16px 36px 30px;font-size:12px;color:#8a8371;font-family:var(--mono);border-top:1px solid #3a362c;}

/* ===== MUSEUM / CASE FILE INDEX ===== */
.museum{background:var(--ink);color:var(--paper);}
.museum .eyebrow{color:var(--yellow);}
.exhibit-list{border-top:1px solid #3a362c;}
.exhibit{border-bottom:1px solid #3a362c;}
.exhibit-head{display:grid;grid-template-columns:90px 1fr 24px;gap:24px;padding:28px 0;align-items:start;cursor:pointer;}
.exhibit .ex-num{font-size:12px;color:#8a8371;font-family:var(--mono);padding-top:4px;}
.exhibit h4{font-size:19px;font-weight:700;margin-bottom:6px;}
.exhibit-head p{font-size:14px;color:#b3ab97;max-width:56ch;text-align:left;}
.exhibit-chevron{font-size:20px;color:#8a8371;transition:transform .25s ease;padding-top:4px;font-family:var(--mono);}
.exhibit.open .exhibit-chevron{transform:rotate(45deg);}
.exhibit-body{max-height:0;overflow:hidden;transition:max-height .35s ease;}
.exhibit.open .exhibit-body{max-height:420px;}
.exhibit-body-inner{padding:0 0 32px 114px;font-size:15px;color:#cfc8b6;max-width:60ch;text-align:justify;}
@media (max-width:640px){.exhibit-head{grid-template-columns:40px 1fr 20px;}.exhibit-body-inner{padding-left:64px;}}

/* ===== EXPERIMENTS ===== */
.experiments{background:var(--paper-2);}
.exp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;background:var(--ink);border:2px solid var(--ink);margin-top:24px;}
.exp-card{background:var(--paper);padding:28px;}
.exp-card h4{font-size:16px;font-weight:700;margin-bottom:10px;}
.exp-status{display:inline-block;font-size:11px;font-family:var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;margin-bottom:14px;border:1px solid var(--ink);}
.exp-status.running{background:#cdeed4;}
.exp-status.recruiting{background:var(--yellow);}
.exp-status.pilot{background:#cddafb;}
.exp-card p{font-size:14px;color:var(--ink-dim);text-align:left;}

/* ===== INDEX ===== */
.hli-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:start;margin-top:40px;}
.hli-panel{border:2px solid var(--ink);background:var(--paper-2);padding:32px;}
.hli-panel h4{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-dim);margin-bottom:20px;}
.hli-bar-row{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
.hli-bar-row .bname{font-size:13px;width:120px;flex-shrink:0;}
.hli-bar-track{flex:1;height:10px;background:#ddd3b3;border-radius:6px;overflow:hidden;border:1px solid var(--ink);}
.hli-bar-fill{height:100%;}
.hli-bar-score{font-family:var(--mono);font-size:13px;width:36px;text-align:right;flex-shrink:0;}
@media (max-width:780px){.hli-grid{grid-template-columns:1fr;}}

/* ===== MISSION CLOSE ===== */
.mission{text-align:center;padding:150px 24px;}
.mission blockquote{font-size:clamp(24px,4vw,42px);font-weight:800;max-width:19ch;margin:0 auto 32px;line-height:1.4;}
.mission cite{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-dim);font-style:normal;}

footer{padding:44px 24px;text-align:center;font-size:11px;color:var(--ink-dim);letter-spacing:.1em;text-transform:uppercase;border-top:2px solid var(--ink);font-family:var(--mono);}

/* ===== CITATIONS / METHODOLOGY ===== */
.cite{font-family:var(--mono);font-size:11.5px;color:var(--ink-dim);border-top:1px dashed var(--line);padding-top:10px;margin-top:14px;max-width:60ch;}
.cite b{color:var(--ink);font-weight:700;}
.pilot-tag{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.4);padding:3px 8px;border-radius:10px;margin-bottom:6px;}
.yellow .pilot-tag{background:rgba(0,0,0,.08);border-color:rgba(0,0,0,.3);}

/* ===== EXPERIMENT ===== */
.exp-table{width:100%;border-collapse:collapse;margin-top:28px;font-size:14px;}
.exp-table th,.exp-table td{border:1px solid var(--ink);padding:12px 16px;text-align:left;}
.exp-table th{background:var(--ink);color:var(--paper);font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.06em;}
.exp-table td.better{color:var(--red);font-weight:800;}
.exp-meta{display:flex;gap:36px;flex-wrap:wrap;margin:28px 0;font-family:var(--mono);font-size:12px;color:var(--ink-dim);}
.exp-meta b{color:var(--ink);display:block;font-size:20px;font-family:var(--sans);font-weight:800;}

/* ===== RESEARCHER ===== */
.researcher{display:grid;grid-template-columns:120px 1fr;gap:32px;align-items:start;margin-top:20px;}
.researcher-mark{width:90px;height:90px;border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:26px;font-weight:700;background:var(--yellow);}
.researcher h4{font-size:19px;font-weight:800;margin-bottom:6px;}
.researcher .role{font-family:var(--mono);font-size:12px;color:var(--ink-dim);margin-bottom:14px;text-transform:uppercase;letter-spacing:.04em;}
@media (max-width:520px){.researcher{grid-template-columns:1fr;}}

/* ===== VISUAL ELEMENTS ===== */
.layer-icon{width:34px;height:34px;flex-shrink:0;}
.layer-row{display:flex;gap:16px;align-items:flex-start;}
.disc-icon{width:26px;height:26px;margin-bottom:12px;opacity:.85;}
.exhibit-link{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:12px;color:var(--yellow);margin-top:14px;text-decoration:none;border-bottom:1px solid rgba(245,212,68,.4);padding-bottom:2px;transition:.15s;}
.exhibit-link:hover{border-color:var(--yellow);}
.origin-illus{margin:44px 0;}
.origin-illus svg{width:100%;height:auto;max-width:640px;display:block;}
.pin-icon{width:16px;height:16px;vertical-align:-3px;margin-right:4px;opacity:.7;}
.disc-card{position:relative;}
.stat-icon{width:22px;height:22px;opacity:.85;margin-bottom:8px;}
.hli-icon{width:20px;height:20px;flex-shrink:0;opacity:.7;}

.reveal.in .origin-illus #hiRect2{animation:hiIn .5s .9s ease forwards;}
.reveal.in .origin-illus #loupe,.reveal.in .origin-illus #loupeHandle{animation:loupeIn .6s .5s cubic-bezier(.4,0,.2,1) forwards;}
#hiRect2{opacity:0;}
#loupe,#loupeHandle{opacity:0;transform:translate(-30px,-14px) scale(.7);transform-origin:120px 74px;}
@keyframes hiIn{to{opacity:1;}}
@keyframes loupeIn{to{opacity:1;transform:translate(0,0) scale(1);}}
.reveal.in .node-n{animation:nodeIn .5s ease forwards;}
.reveal.in .node-n:nth-of-type(1){animation-delay:.15s;}
.reveal.in .node-n:nth-of-type(2){animation-delay:.3s;}
.reveal.in .node-n:nth-of-type(3){animation-delay:.45s;}
.reveal.in .node-n:nth-of-type(4){animation-delay:.6s;}
.node-n{opacity:0;transform:scale(.7);transform-box:fill-box;transform-origin:center;}
@keyframes nodeIn{to{opacity:1;transform:scale(1);}}

.reveal{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease;}
.reveal.in{opacity:1;transform:translateY(0);}
@media (prefers-reduced-motion: reduce){.reveal{opacity:1;transform:none;transition:none;}}
</style>
</head>
