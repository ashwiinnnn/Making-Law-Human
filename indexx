        <text x="380" y="112" font-family="Space Mono, monospace" font-size="9.5" fill="#b3ab97" letter-spacing="1">HUMAN READER</text>
        <text x="440" y="79" font-family="Space Mono, monospace" font-size="22" fill="var(--red)">?</text>
