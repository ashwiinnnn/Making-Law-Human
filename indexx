        <div class="hli-bar-row" style="margin-top:26px;"><div class="bname" style="font-weight:800;">Human Score</div><div class="hli-bar-track"><div class="hli-bar-fill" style="width:28%;background:var(--blue);"></div></div><div class="hli-bar-score" style="font-weight:800;">28</div></div>
