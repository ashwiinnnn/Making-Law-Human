        <circle cx="400" cy="75" r="16" fill="none" stroke="var(--paper)" stroke-width="1.8" id="faceHead"/>
        <circle cx="393" cy="72" r="1.6" fill="var(--paper)"/>
        <circle cx="407" cy="72" r="1.6" fill="var(--paper)"/>
