<script>
// progress bar
window.addEventListener('scroll', ()=>{
  const h = document.documentElement;
  const pct = (h.scrollTop)/(h.scrollHeight - h.clientHeight) * 100;
  document.getElementById('progress').style.width = pct + '%';
});

// reveal on scroll
const reveals = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:0.1});
reveals.forEach(r=>io.observe(r));

// count-up stats
const nums = document.querySelectorAll('.num[data-count]');
const io2 = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      const target = +e.target.dataset.count;
      let cur = 0;
      const step = Math.max(1, Math.round(target/40));
      const t = setInterval(()=>{
        cur += step;
        if(cur >= target){ cur = target; clearInterval(t); }
        e.target.textContent = cur;
      }, 20);
      io2.unobserve(e.target);
    }
  });
}, {threshold:0.4});
nums.forEach(n=>io2.observe(n));

// legal/human toggle — the signature interaction
const btnLegal = document.getElementById('btnLegal');
const btnHuman = document.getElementById('btnHuman');
const docLegal = document.getElementById('docBlock');
const docHuman = document.getElementById('docBlockHuman');
btnLegal.addEventListener('click', ()=>{
  btnLegal.classList.add('active'); btnHuman.classList.remove('active');
  docLegal.style.display=''; docHuman.style.display='none';
});
btnHuman.addEventListener('click', ()=>{
  btnHuman.classList.add('active'); btnLegal.classList.remove('active');
  docHuman.style.display=''; docLegal.style.display='none';
});

// clause x-ray demo
const demoBody = document.getElementById('demoBody');
document.querySelectorAll('.swatch-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.swatch-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    demoBody.dataset.active = btn.dataset.c;
  });
});

// reasonable time slider
const rtSlider = document.getElementById('rtSlider');
const rtFill = document.getElementById('rtFill');
const rtLabel = document.getElementById('rtLabel');
function updateRT(){
  const v = +rtSlider.value;
  let label;
  if(v < 25){ label = "Dispute likelihood: low. Both sides roughly agree what \"reasonable\" means here."; }
  else if(v < 55){ label = "Dispute likelihood: rising. One side is already assuming a much shorter window than the other."; }
  else if(v < 80){ label = "Dispute likelihood: high. \"Reasonable\" has quietly become two incompatible promises."; }
  else { label = "Dispute likelihood: this is now a legal proceeding, not a delivery date."; }
  rtFill.style.width = v + '%';
  rtLabel.textContent = label;
}
rtSlider.addEventListener('input', updateRT);
updateRT();

// exhibits — all 16 articles as case-file entries
const exhibits = [
  {n:"01", t:"The Hidden Refund", d:"A DJ subscription, a buried clause, and 120 dollars that explained an entire discipline better than fifty academic papers could.", body:"Buried in section sixteen of a music subscription's terms: integration limited to one specific brand of equipment. The customer service rep's closing line was that it was clearly stated in the terms I agreed to. This became the origin story for the whole project.", url:"https://www.linkedin.com/posts/ashwin-gupta001_makinglawhuman-legaldesign-makinglawhuman-activity-7304690730969575424-Nno3"},
  {n:"02", t:"What Does This Mean?", d:"Watching a friend's contract turn from a wall of jargon into a question she could actually ask out loud.", body:"Legal design flips a power dynamic on its head: the radical notion that legal documents should make sense to the humans using them. The leap from \"I don't understand any of this\" to \"so my payment is due on the 15th\" is not just clarity, it is empowerment.", url:"https://www.linkedin.com/posts/ashwin-gupta001_thereisabetterway-makinglawhuman-legaldesign-activity-7307305811733622785-atv7"},
  {n:"03", t:"No More Walls of Text", d:"We process visuals sixty thousand times faster than text. Contracts have not caught up.", body:"The question is not why make contracts visual, it is why we are still relying on dense, text heavy contracts at all. When a contract tells the story of what it actually does, the fine print stops needing to hide.", url:"https://www.linkedin.com/posts/ashwin-gupta001_thereisabetterway-legaldesign-makinglawhuman-activity-7308766757681340418-nHLm"},
  {n:"04", t:"The Impossible NDA", d:"Rebuilt from scratch, same substance, a layout that works with human psychology instead of against it.", body:"Traditional legal formatting is built to repel human attention: dense paragraphs, endless walls of text, font sizes that require superhuman vision. The rebuild keeps every definition and obligation in full force, but adds visual hierarchy, spacing, and a layout the eye can actually follow.", url:"https://www.linkedin.com/posts/ashwin-gupta001_thereisabetterway-legaldesign-makinglawhuman-activity-7318087328902627329-9xT5"},
  {n:"05", t:"The Layered Cake", d:"Step into the client's shoes, decode the real problem, then prototype and keep improving.", body:"Conventional law looks backward. Legal design looks forward. It is not about winning, it is about understanding, and about making complex human interactions feel human again.", url:"https://www.linkedin.com/posts/ashwin-gupta001_therelsabetterway-legaldesign-makinglawhuman-activity-7319954579301756928-4tJK"},
  {n:"06", t:"Fifty Documents Later", d:"It was not shorter sentences. It was not icons. It was color.", body:"Blue checkboxes meant more completed forms. Red alerts, used right, meant fewer confused clients. A tiny yellow highlight meant more people actually reading their own rights. Color is not decoration in a legal document, it is direction.", url:"https://www.linkedin.com/posts/ashwin-gupta001_thereisabetterway-legaldesign-makinglawhuman-activity-7328691991154741248-GKSh"},
  {n:"07", t:"Blue: The Quiet Overachiever", d:"Trustworthy was not the top response for blue. It was the dominant one.", body:"Blue helps people read faster, remember more, and feel at ease. Too little, it goes unnoticed. Too much, and the document reads like a birthday invitation instead of a contract that means something.", url:"https://www.linkedin.com/posts/ashwin-gupta001_legaldesign-colorpsychology-blue-activity-7334186680863571968-mcWY"},
  {n:"08", t:"Red: The Fire Alarm", d:"Loud when needed, silent otherwise. That is the whole rule.", body:"Red triggers an immediate stress response, which is exactly why it should be rare. Save it for what actually matters: real deadlines, major liability shifts, deal breakers. If everything is urgent, nothing is.", url:"https://www.linkedin.com/posts/ashwin-gupta001_psychology-of-colors-red-activity-7340589948078563328-i-Zl"},
  {n:"09", t:"Yellow: The Underestimated One", d:"People notice it eighty eight percent faster than most colors, but it never yells.", body:"A clause buried in paragraph forty seven goes unread. Highlight it in yellow, and suddenly it does not. Yellow does not warn, it guides, and that is the whole point of making law more human.", url:"https://www.linkedin.com/posts/ashwin-gupta001_psychology-of-colors-yellow-activity-7343515038663548928-a-XI"},
  {n:"10", t:"Do I Need A Designer?", d:"Collaboration always helps. You do not need to wait for a design team to start.", body:"Legal design is not about aesthetics or fancy software, it is about making law work for people, and that starts with the people already trained to solve problems: lawyers. Redesign a form. Rewrite a clause. Start small.", url:"https://www.linkedin.com/posts/ashwin-gupta001_legaldesign-lawyerswhodesign-designthinking-activity-7349391717327917056-ejdZ"},
  {n:"11", t:"The Silence Is The Failure", d:"When the questions stop and the client nods without understanding, that is not clarity.", body:"The legal industry has normalized confusion and called it standard. Legal design is not about lowering standards, it is about raising the bar for how people experience the law, feelings included.", url:"https://www.linkedin.com/posts/ashwin-gupta001_legaldesign-makinglawhuman-claritymatters-activity-7351134258930880513-8ZNv"},
  {n:"12", t:"The Clause That Shouldn't Exist", d:"It exists because someone already crossed the line it describes. Enough times to need a clause.", body:"We have all been tempted to drop a wordy clause into an AI tool for a quick fix. One tiny shortcut feels harmless, until the mistake that should not happen already has, and the next one is waiting.", url:"https://www.linkedin.com/posts/ashwin-gupta001_ai-legaltech-law-activity-7366356574551875585-d5W8"},
  {n:"13", t:"AI Is A Tool, Not A Scapegoat", d:"Confidential information: still your duty. AI outputs: still your job to check.", body:"A year ago, AI related clauses barely existed. Now they quietly define who checks the outputs, who carries the risk, and who pays when an AI confidently insists that two plus two equals banana.", url:"https://www.linkedin.com/posts/ashwin-gupta001_law-contracts-legaltech-activity-7369595145421275138-59k-"},
  {n:"14", t:"Reasonable Is Not A Timeline", d:"Two weeks to you. Six months to them. In court, nobody knows.", body:"Vague contracts turn into drawn out projects and frustrated teams. The fix is not complicated: replace fluff with clarity, real dates, real numbers, real limits. It may feel too direct at first, but it prevents the headache of everyone quietly assuming something different.", url:"https://www.linkedin.com/posts/ashwin-gupta001_makinglawhuman-legaldesign-contracts-activity-7374686889989058560-7DhP"},
  {n:"15", t:"Clauses Written To Outlive Their Purpose", d:"The contract ends. The deal dies. The clause is somehow still there.", body:"Forever does not protect anything. Secrets lose value, technology changes, companies disappear. A clause that outlives its purpose is not a safeguard, it is confusion with a signature on it.", url:"https://www.linkedin.com/posts/ashwin-gupta001_makinglawhuman-legaldesign-contracts-activity-7376830311072124928-z6NB"},
  {n:"16", t:"Powerless", d:"On the gap between what AI can draft and what it will never understand.", body:"AI can draft a perfect contract. It will never know what it feels like to be on the other side of it, reading at midnight, too embarrassed to ask what a clause means because you already asked twice. No one should feel powerless reading documents about their own future. That gap is what this project exists to close.", url:"https://www.linkedin.com/posts/ashwin-gupta001_legaldesign-makinglawhuman-thereisabetterway-activity-7446916055421333504-uPDh"}
];
